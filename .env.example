# Copy to .env and fill in. Never commit .env.
# Use your OWN Halo trial instance only. Never an employer or client instance.

# API base, e.g. https://yourtrial.halopsa.com/api
HALO_API_URL=

# Auth base, e.g. https://yourtrial.halopsa.com/auth
# (check the Authorisation Server shown under Configuration > Integrations > Halo API)
HALO_AUTH_URL=

# Only needed if your auth server is shared and asks for a tenant. Leave blank otherwise.
HALO_TENANT=

# From Configuration > Integrations > Halo API > View Applications > your app
HALO_CLIENT_ID=
HALO_CLIENT_SECRET=
HALO_SCOPE=all

# Safety switches for anything that writes to Halo.
# Writes are refused unless BOTH are set exactly like this.
HALO_ALLOW_WRITES=false
HALO_INSTANCE_LABEL=my-own-trial
